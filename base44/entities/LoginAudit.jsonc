{
  "name": "LoginAudit",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "denied",
        "error"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "pin",
        "voice",
        "qr"
      ]
    },
    "reason": {
      "type": "string"
    },
    "created_at_client": {
      "type": "string"
    }
  },
  "required": [
    "username",
    "result",
    "method"
  ]
}