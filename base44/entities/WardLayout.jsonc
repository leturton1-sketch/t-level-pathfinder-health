{
  "name": "WardLayout",
  "type": "object",
  "properties": {
    "suite": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "ward"
      ],
      "title": "Suite"
    },
    "items": {
      "type": "string",
      "description": "JSON array of placed items: [{id, type, x, z, rotationY, designation, expanded}]"
    },
    "layout_name": {
      "type": "string",
      "default": "Default"
    }
  },
  "required": [
    "suite",
    "items"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}