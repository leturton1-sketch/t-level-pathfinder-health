{
  "name": "CarePlanSubmission",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "abcde",
        "smart_goals",
        "risk_assessment",
        "news2",
        "fluid_balance",
        "handover_sbar",
        "mdt_referral",
        "reflective_log",
        "action_plan"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "JSON of form data"
    },
    "linked_scenario": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "revised"
      ],
      "default": "draft"
    },
    "tutor_feedback": {
      "type": "string"
    },
    "tutor_id": {
      "type": "string"
    },
    "sk_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "performance_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ehr_drug_chart_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student read the EHR Drug Chart tab before submitting"
    },
    "ehr_nursing_notes_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student read the EHR Nursing Notes tab before submitting"
    },
    "ehr_lab_results_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student read the EHR Lab Results tab before submitting"
    }
  },
  "required": [
    "student_id",
    "type",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}