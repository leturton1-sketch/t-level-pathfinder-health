{
  "name": "AppSession",
  "type": "object",
  "properties": {
    "app_user_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "pin",
        "qr",
        "voice"
      ]
    }
  },
  "required": [
    "app_user_id",
    "token_hash",
    "expires_at",
    "revoked",
    "auth_method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}